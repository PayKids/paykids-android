<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray3">

    <Toolbar
        android:id="@+id/tb_chat"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:contentInsetStart="0dp"

        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"

            android:fontFamily="@font/nanumsquare_extra_bold"
            android:text="@string/text_study_title"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/ib_back"
            android:layout_width="48dp"
            android:layout_height="48dp"

            android:layout_marginStart="4dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/ic_left_blue" />
    </Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/fl_chat_input"
        app:layout_constraintTop_toBottomOf="@id/tb_chat"
        tools:listitem="@layout/item_chat_my" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_chat_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_chat">

        <EditText
            android:id="@+id/et_send_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"

            android:layout_marginTop="20dp"
            android:background="@drawable/shape_radius_send_chat"
            android:hint="@string/hint_chat"

            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxHeight="80dp"
            android:maxLength="200"
            android:minHeight="40dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray7"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="안녕하세요\n안녕하세요\n안녕하세요안녕하세요안녕하세요안녕하세요안녕하세요" />

        <ImageView
            android:id="@+id/ib_send"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="14dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/ic_send"

            app:layout_constraintBottom_toBottomOf="@id/et_send_chat"
            app:layout_constraintEnd_toEndOf="@id/et_send_chat"
            app:layout_constraintTop_toTopOf="@id/et_send_chat" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>