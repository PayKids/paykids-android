<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_daily_quest"
        style="@style/heading3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:text="일일 퀘스트"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_desc_daily_quest"
        style="@style/body2_B"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/nanumsquare_bold"
        android:text="퀘스트를 완료하고 배지를 받아보세요!"
        android:textColor="@color/blue1"

        app:layout_constraintStart_toStartOf="@id/tv_daily_quest"
        app:layout_constraintTop_toBottomOf="@id/tv_daily_quest" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_quest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"

        app:layout_constraintTop_toBottomOf="@id/tv_desc_daily_quest"
        tools:itemCount="4"
        tools:listitem="@layout/item_quest" />

</androidx.constraintlayout.widget.ConstraintLayout>