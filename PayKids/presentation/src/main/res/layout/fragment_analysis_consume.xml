<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5"
    android:padding="12dp">

    <ImageButton
        android:id="@+id/ib_left"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-8dp"
        android:background="@color/transparent"
        android:src="@drawable/ic_left_round"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tv_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/ib_left"

        app:layout_constraintStart_toEndOf="@+id/ib_left"
        app:layout_constraintTop_toTopOf="@id/ib_left"
        tools:text="12월" />

    <ImageButton
        android:id="@+id/ib_right"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/transparent"
        android:src="@drawable/ic_right_round"

        app:layout_constraintBottom_toBottomOf="@+id/ib_left"
        app:layout_constraintStart_toEndOf="@+id/tv_month"
        app:layout_constraintTop_toTopOf="@+id/ib_left"
        tools:ignore="ContentDescription" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_switch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_month"
        tools:context=".ToggleBtActivity">

        <LinearLayout
            android:id="@+id/ll_switch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/switch_bg_outline"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_consume"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/switch_bg_select"
                android:fontFamily="@font/nanumsquare_extra_bold"
                android:gravity="center"
                android:text="@string/dialog_switch_consum"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/tv_income"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/nanumsquare_extra_bold"
                android:gravity="center"
                android:text="@string/dialog_switch_income"
                android:textColor="@color/gray7"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_month_consumption"
        style="@style/heading3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="36dp"

        android:fontFamily="@font/nanumsquare_extra_bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/cl_switch"
        tools:text="150,000원 사용 중" />

    <LinearLayout
        android:id="@+id/ll_progressBar"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_radius_progress_bar"

        app:layout_constraintEnd_toEndOf="@id/cl_switch"
        app:layout_constraintStart_toStartOf="@id/cl_switch"
        app:layout_constraintTop_toBottomOf="@id/tv_month_consumption">

        <com.paykids.presentation.custom.CategoryProgressView
            android:layout_marginHorizontal="1dp"
            android:id="@+id/categoryProgressView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_delete"
        android:layout_width="108dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@id/cl_switch"
        app:layout_constraintTop_toBottomOf="@id/ll_progressBar">

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_radius_delete_category"
            android:fontFamily="@font/nanumsquare_bold"
            android:gravity="center"
            android:text="@string/text_delete_category"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </FrameLayout>

    <!-- 스크롤 가능한 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_delete">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_consume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="5"
                tools:listitem="@layout/item_analysis_consumption" />

            <Button
                android:id="@+id/btn_add_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_radius_add_category"
                android:fontFamily="@font/nanumsquare_extra_bold"
                android:text="@string/text_add_category"
                android:textColor="@color/gray7"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>