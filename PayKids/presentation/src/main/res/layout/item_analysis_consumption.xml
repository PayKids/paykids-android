<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/shape_consumption_status"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_comsumption_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"

        android:fontFamily="@font/nanumsquare_extra_bold"
        android:textColor="@color/blue1"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="120dp"
        app:layout_constraintWidth_min="80dp"
        tools:text="편의점" />

    <EditText
        android:id="@+id/edit_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="LabelFor, Autofill" />

    <TextView
        android:id="@+id/tv_consume_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_comsumption_category"

        app:layout_constraintEnd_toStartOf="@id/frame_checkbox_percent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toEndOf="@id/tv_comsumption_category"
        app:layout_constraintTop_toTopOf="@id/tv_comsumption_category"
        tools:text="-1,800" />

    <FrameLayout
        android:id="@+id/frame_checkbox_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nanumsquare_extra_bold"
            android:textColor="@color/gray1"
            android:textSize="18sp"
            android:visibility="visible"
            tools:text="50%" />

        <ImageView
            android:id="@+id/checkbox_category"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_checkbox_unchecked"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>