<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5">

    <TextView
        android:id="@+id/tv_mypage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/white"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:gravity="center"
        android:includeFontPadding="false"

        android:text="@string/text_my_page"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_header"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/transparent"
        android:contentDescription="@null"
        android:src="@drawable/ic_left"

        app:layout_constraintBottom_toBottomOf="@id/tv_mypage"
        app:layout_constraintStart_toStartOf="@id/tv_mypage"
        app:layout_constraintTop_toTopOf="@id/tv_mypage"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageView
        android:id="@+id/iv_profile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"

        android:background="@drawable/round_image"
        android:clipToOutline="true"
        android:contentDescription="@string/content_description_profile"
        android:scaleType="fitXY"
        android:src="@drawable/img_dice"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_mypage"
        tools:ignore="NewApi,UnusedAttribute" />

    <ImageView
        android:id="@+id/iv_modify_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_add_photo"

        app:layout_constraintBottom_toBottomOf="@id/iv_profile"
        app:layout_constraintEnd_toEndOf="@id/iv_profile"
        app:layout_constraintMarginBottom="8dp"
        app:layout_constraintMarginEnd="8dp" />

    <TextView
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:includeFontPadding="false"
        android:text="nickname"
        android:textColor="@color/black"
        android:textSize="24sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_profile" />

    <View
        android:id="@+id/view_my_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="80dp"

        android:background="@drawable/shape_radius_top_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

    <TextView
        android:id="@+id/tv_my_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:text="@string/text_my_info"
        android:textColor="@color/black"
        android:textSize="20sp"

        app:layout_constraintEnd_toEndOf="@id/view_my_info"
        app:layout_constraintStart_toStartOf="@id/view_my_info"
        app:layout_constraintTop_toTopOf="@id/view_my_info" />

    <TextView
        android:id="@+id/tv_modify_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:text="@string/text_nickname"
        android:textColor="@color/black"
        android:textSize="20sp"

        app:layout_constraintStart_toStartOf="@id/view_my_info"
        app:layout_constraintTop_toBottomOf="@id/tv_my_info" />

    <TextView
        android:id="@+id/tv_email_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:text="@string/text_email"
        android:textColor="@color/black"
        android:textSize="20sp"

        app:layout_constraintStart_toStartOf="@id/tv_modify_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_modify_nickname" />

    <EditText
        android:id="@+id/et_modify_nickname"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="24dp"

        android:background="@drawable/border_radius_10"
        android:fontFamily="@font/nanumsquare_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:inputType="text"
        android:maxLength="8"
        android:textColor="@color/black"
        android:textSize="16sp"

        app:layout_constraintBottom_toBottomOf="@id/tv_modify_nickname"
        app:layout_constraintEnd_toEndOf="@id/view_my_info"
        app:layout_constraintStart_toEndOf="@id/tv_modify_nickname"
        app:layout_constraintTop_toTopOf="@id/tv_modify_nickname"
        tools:ignore="Autofill,LabelFor"
        tools:text="수정된 닉네임" />

    <TextView
        android:id="@+id/tv_email"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="24dp"

        android:background="@drawable/border_radius_10"
        android:fontFamily="@font/nanumsquare_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_email_text"

        app:layout_constraintEnd_toEndOf="@id/view_my_info"
        app:layout_constraintStart_toEndOf="@id/tv_email_text"
        app:layout_constraintTop_toTopOf="@id/tv_email_text"
        tools:ignore="Autofill,LabelFor"
        tools:text="hbj0209@kakao.com" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"

        android:fontFamily="@font/nanumsquare_extra_bold"
        android:text="@string/text_withdrawal"
        android:textColor="@color/red"
        android:textSize="16sp"

        app:layout_constraintBottom_toBottomOf="@id/view_my_info"
        app:layout_constraintEnd_toEndOf="@id/view_my_info"
        app:layout_constraintStart_toStartOf="@id/view_my_info" />

</androidx.constraintlayout.widget.ConstraintLayout>