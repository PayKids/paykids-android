<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_clear"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_quiz_clear"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/tv_clear_message"
        android:layout_width="0dp"
        android:layout_height="109dp"
        android:layout_marginBottom="182.5dp"
        android:background="@drawable/shape_quiz_clear_box"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:gravity="center"
        android:lineHeight="26sp"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tv_exit"
        app:layout_constraintEnd_toEndOf="@id/tv_exit"
        app:layout_constraintStart_toStartOf="@id/tv_exit"
        tools:text="스테이지 클리어!\n놀라워요! 모든 문제를 다 맞혔어요!" />

    <TextView
        android:id="@+id/tv_exit"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="57dp"
        android:background="@drawable/shape_quiz_exit_box"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:gravity="center"
        android:text="나가기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_wrong_answer_note"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="57dp"
        android:background="@drawable/shape_quiz_wrong_answer_note_box"
        android:fontFamily="@font/nanumsquare_extra_bold"
        android:gravity="center"
        android:text="오답노트 풀기"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="20dp" />
</androidx.constraintlayout.widget.ConstraintLayout>