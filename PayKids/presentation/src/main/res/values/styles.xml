<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavLabelStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:translationY">-8dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 바텀 내비게이션 활성화된 아이템의 텍스트 스타일 -->
    <style name="BottomNavTextActive">
        <item name="fontFamily">@font/nanumsquare_extra_bold</item>
    </style>

    <!-- 바텀 내비게이션 비활성화된 아이템의 텍스트 스타일 -->
    <style name="BottomNavTextInactive">
        <item name="fontFamily">@font/nanumsquare_extra_bold</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomSpinnerStyle">
        <item name="android:drawableEnd">@drawable/ic_down</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/nanumsquare_bold</item>
    </style>

    <!-- TabLayout 커스텀 스타일 -->
    <style name="CustomTabLayoutStyle" parent="Widget.Design.TabLayout">
        <!-- 인디케이터 색상 -->
        <item name="tabIndicatorColor">@color/blue1</item>
        <!-- 인디케이터 두께 -->
        <item name="tabIndicatorHeight">4dp</item>
        <!-- 선택된 탭 텍스트 색상 -->
        <item name="tabTextColor">@color/gray2</item>
        <item name="tabSelectedTextColor">@color/blue1</item>
        <!-- 탭 배경 -->
        <item name="tabBackground">@color/white</item>

        <item name="fontFamily">@font/nanumsquare_extra_bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>