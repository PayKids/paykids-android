        android:name="com.paykids.presentation.view.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_quizEntryFragment"
            app:destination="@id/quizEntryFragment" />
    </fragment>

    <fragment
        android:id="@+id/studyFragment"
        android:name="com.paykids.presentation.view.quiz.StudyFragment"
        android:label="fragment_study"
        tools:layout="@layout/fragment_study">
        <argument
            android:name="stageNumber"
            app:argType="integer" />
    </fragment>

