            android:id="@+id/action_quizEntryFragment_to_quizMultipleChoiceImgFragment"
            app:destination="@id/quizMultipleChoiceImgFragment"
            app:popUpTo="@id/quizEntryFragment"
            app:popUpToInclusive="false" />
