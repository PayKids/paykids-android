        android:label="fragment_quiz_entry"
        tools:layout="@layout/fragment_quiz_entry">
        <action
            android:id="@+id/action_quizEntryFragment_to_studyFragment"
            app:destination="@id/studyFragment"
            app:popUpTo="@id/quizEntryFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_quizEntryFragment_to_quizImageFragment"
            app:destination="@id/quizImageFragment"
            app:popUpTo="@id/quizEntryFragment"
            app:popUpToInclusive="false" />
