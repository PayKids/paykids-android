<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/diaryFragment"
        android:name="com.paykids.presentation.view.diary.DiaryFragment"
        android:label="fragment_diary"
        tools:layout="@layout/fragment_diary">
        <action
            android:id="@+id/action_diaryFragment_to_analysisConsumeFragment"
            app:destination="@id/analysisConsumeFragment" />
        <argument
            android:name="currentYear"
            app:argType="integer" />
        <argument
            android:name="currentMonth"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/analysisConsumeFragment"
        android:name="com.paykids.presentation.view.diary.AnalysisConsumeFragment"
        android:label="fragment_analysis_cosume"
        tools:layout="@layout/fragment_analysis_allowance">
        <action
            android:id="@+id/action_analysisConsumeFragment_to_analysisCategoryConsumeFragment"
            app:destination="@id/analysisCategoryConsumeFragment" />
        <argument
            android:name="currentYear"
            app:argType="integer" />
        <argument
            android:name="currentMonth"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/analysisCategoryConsumeFragment"
        android:name="com.paykids.presentation.view.diary.AnalysisCategoryConsumeFragment"
        android:label="fragment_analysis_category_consume"
        tools:layout="@layout/fragment_analysis_category_allowance">
        <argument
            android:name="currentYear"
            app:argType="integer" />
        <argument
            android:name="currentMonth"
            app:argType="integer" />
        <argument
            android:name="category"
            app:argType="string" />
        <argument
            android:name="amount"
            app:argType="integer" />
        <argument
            android:name="isConsumeClicked"
            app:argType="boolean" />
    </fragment>

    <fragment
